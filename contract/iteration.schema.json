{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/business-agent/iteration.schema.json",
  "title": "Iteration",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "stage", "createdAt", "requester", "channel", "repos", "branchName", "requirementVersion"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{4}-[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["working", "blocked", "completed", "abandoned"] },
    "stage": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "requester": { "type": "string" },
    "channel": { "enum": ["web", "ide", "api", "adapter"] },
    "repos": { "type": "array", "items": { "type": "string" } },
    "branchName": { "type": "string", "pattern": "^feat/.+" },
    "requirementVersion": { "type": "string" },
    "base": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "sha"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "sha": { "type": "string", "minLength": 7 }
        }
      }
    }
  }
}
