# 复制为实例根目录的 .env，权限设为仅所有者可读写。不要提交 .env。

# Web 访问口令
AGENT_WEB_PASSWORD=

# 浏览器实际访问的源，含协议和端口。回调与预览都基于它。
AGENT_PUBLIC_ORIGIN=

# 兼容 Chat Completions 的基地址与密钥。值只放在这里。
AGENT_MODEL_ENDPOINT=
AGENT_MODEL_API_KEY=
AGENT_DIALOGUE_MODEL=
AGENT_CODING_MODEL=

# 可选。只读证据源关闭时留空。
AGENT_EVIDENCE_ENDPOINT=
AGENT_EVIDENCE_TOKEN=
